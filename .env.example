# Supabase — this project's OWN project, no data shared with BARBAH.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"

# Resend — welcome email sent directly from the Worker (src/lib/resend-send.server.ts).
# Verification/reset emails go through Supabase Auth's Custom SMTP, configured
# in the Supabase dashboard with Resend's SMTP credentials — not here.
RESEND_API_KEY="re_your-api-key"

# Bearer token gating the Supabase "new user" database webhook route
# (src/lib/new-user-webhook-route.server.ts). Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SUPABASE_WEBHOOK_SECRET="your-random-bearer-token"
