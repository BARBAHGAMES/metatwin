# Supabase — this project's OWN project, no data shared with BARBAH.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"

# Resend — welcome email sent directly from the Worker (src/lib/resend-send.server.ts),
# from hello@metaglobetechnologies.co.ke (already-verified domain — reused
# instead of registering metatwin.metaglobe.co.ke, which would have needed a
# Resend plan upgrade). Verification/reset emails go through Supabase Auth's
# Custom SMTP, configured in the Supabase dashboard with Resend's SMTP
# credentials — not here.
RESEND_API_KEY="re_your-api-key"

# Bearer token gating the Supabase "new user" database webhook route
# (src/lib/new-user-webhook-route.server.ts). Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SUPABASE_WEBHOOK_SECRET="your-random-bearer-token"

# Visitor feedback (Release A). Optional but recommended before wide launch.
# Cloudflare Turnstile: the SITE key is public and inlined into the browser
# bundle at build time (keep it here in .env); the SECRET key is a Worker secret:
#   npx wrangler secret put TURNSTILE_SECRET_KEY --config .output/server/wrangler.json
# The form works without them (rate limits + email confirmation only).
VITE_TURNSTILE_SITE_KEY=""
# Daily-rotating salt for deck-view de-duplication hashes. Worker secret, not .env:
#   npx wrangler secret put DECK_VIEW_SALT --config .output/server/wrangler.json
