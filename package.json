{
  "name": "metatwin",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node scripts/patch-wrangler.cjs",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:db": "node supabase/tests/local/run.mjs",
    "db:audit": "node supabase/tests/local/audit.mjs",
    "format": "prettier --write .",
    "check-grants": "node scripts/check-grants.mjs",
    "check-migrations-sync": "node scripts/check-migrations-sync.mjs",
    "check-content-drift": "node scripts/check-content-drift.mjs",
    "content-snapshot": "node scripts/check-content-drift.mjs --write",
    "predeploy": "node scripts/check-grants.mjs && node scripts/check-migrations-sync.mjs && node scripts/check-content-drift.mjs",
    "deploy": "npm run build && npx wrangler deploy --config .output/server/wrangler.json"
  },
